<script>
  // ── Help sentence builder ──
  function buildSentence() {
    const f1 = document.getElementById('f1').value.trim();
    const f2 = document.getElementById('f2').value.trim();
    const f3 = document.getElementById('f3').value.trim();
    const preview = document.getElementById('sentence-preview');
    const btn = document.getElementById('copy-btn');

    if (!f1 && !f2 && !f3) { preview.style.display = 'none'; btn.style.display = 'none'; return; }

    const v1 = f1 || '<span style="color:#aaa;">______</span>';
    const v2 = f2 || '<span style="color:#aaa;">______</span>';
    const v3 = f3 || '<span style="color:#aaa;">______</span>';

    preview.innerHTML =
      `"이번 분기에 <strong style="color:var(--blue2);">${v1}</strong> 하려 하는데,<br>` +
      `<strong style="color:#c0392b;">${v2}</strong> 부분에서 어려움이 있으니<br>` +
      `<strong style="color:var(--teal2);">${v3}</strong> 를 같이 도와줄 수 있는 사람을 찾습니다."`;
    preview.style.display = 'block';
    btn.style.display = (f1 && f2 && f3) ? 'inline-block' : 'none';
  }

  function copySentence() {
    const f1 = document.getElementById('f1').value.trim();
    const f2 = document.getElementById('f2').value.trim();
    const f3 = document.getElementById('f3').value.trim();
    const text = `"이번 분기에 ${f1} 하려 하는데, ${f2} 부분에서 어려움이 있으니 ${f3} 를 같이 도와줄 수 있는 사람을 찾습니다."`;
    navigator.clipboard.writeText(text).then(() => {
      const ok = document.getElementById('copy-ok');
      ok.style.display = 'inline';
      setTimeout(() => { ok.style.display = 'none'; }, 2000);
    });
  }

  // ── Tab switching ──
  function switchTab(id) {
    document.querySelectorAll('.tab-view').forEach(v => v.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + id).classList.add('active');
    event.currentTarget.classList.add('active');
    window.scrollTo(0, 0);
  }

  // ── Detail member filter ──
  function switchDetail(id, btn) {
    document.querySelectorAll('#detailNav .detail-nb').forEach(b => b.classList.remove('on'));
    btn.classList.add('on');
    document.querySelectorAll('.member-block').forEach(block => {
      block.style.display = (id === 'all' || block.dataset.member2 === id) ? 'block' : 'none';
    });
  }

  // ── Pillar filter (Tab 1) ──
  let activePillar = null;
  // 원래 카드 순서 저장
  let originalOrder = null;

  function filterByPillar(num, name, desc) {
    activePillar = num;
    const grid = document.getElementById('personGrid');
    const cards = Array.from(grid.querySelectorAll('.person-card'));

    // 처음 클릭 시 원래 순서 저장
    if (!originalOrder) {
      originalOrder = cards.map(c => c.cloneNode(true));
    }

    const matched   = cards.filter(c => c.dataset.pillars.split(',').map(Number).includes(num));
    const unmatched = cards.filter(c => !c.dataset.pillars.split(',').map(Number).includes(num));

    // 그리드 비우고 matched 먼저, unmatched 나중에
    grid.innerHTML = '';

    matched.forEach(c => {
      c.classList.add('highlighted');
      c.classList.remove('faded');
      c.style.transition = 'opacity .25s, transform .25s';
      grid.appendChild(c);
    });
    unmatched.forEach(c => {
      c.classList.add('faded');
      c.classList.remove('highlighted');
      c.style.transition = 'opacity .25s';
      grid.appendChild(c);
    });

    // pillar 활성화
    document.querySelectorAll('.k-pillar').forEach(p => {
      p.classList.toggle('active', parseInt(p.dataset.pillar) === num);
    });

    const info = document.getElementById('pillarInfo');
    info.textContent = `Pillar ${num}: ${name} — ${desc}`;
    info.classList.add('visible');
    document.getElementById('resetBtn').classList.add('visible');

    // 그리드 위치로 부드럽게 스크롤
    grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function resetFilter() {
    activePillar = null;
    const grid = document.getElementById('personGrid');

    if (originalOrder) {
      grid.innerHTML = '';
      originalOrder.forEach(c => {
        c.classList.remove('highlighted', 'faded');
        // 이벤트 핸들러 재연결 불필요 — onclick은 HTML attribute라 cloneNode로 유지됨
        grid.appendChild(c);
      });
      originalOrder = null;
    } else {
      document.querySelectorAll('.person-card').forEach(c => c.classList.remove('highlighted', 'faded'));
    }

    document.querySelectorAll('.k-pillar').forEach(p => p.classList.remove('active'));
    document.getElementById('pillarInfo').classList.remove('visible');
    document.getElementById('resetBtn').classList.remove('visible');
  }
</script>

